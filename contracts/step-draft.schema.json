{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:master-experience:step-draft:v1",
  "title": "Unapproved model proposal, not a published instruction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "steps", "warnings"],
  "properties": {
    "schema_version": {"const": "1"},
    "language": {"enum": ["ru", "kk", "mixed"]},
    "steps": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "description", "start_ms", "end_ms", "evidence_segment_ids"],
        "properties": {
          "title": {"type": "string", "minLength": 3, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 2000},
          "start_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
          "end_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
          "evidence_segment_ids": {
            "type": "array", "minItems": 1, "maxItems": 300, "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    },
    "warnings": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"enum": ["insufficient_evidence", "unclear_speech", "missing_parameters", "overlapping_ranges", "non_procedural_speech"]},
          "message": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}
