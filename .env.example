# Local development only. Copy to .env and choose a password (12+ characters).
DJANGO_DEBUG=1
DEMO_MODE=1
DEMO_PASSWORD=
# Production requires a secret, PostgreSQL, HTTPS and completion of the D0 gates.
DJANGO_SECRET_KEY=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=master_experience
# POSTGRES_USER=master_experience
# POSTGRES_PASSWORD=

# Real uploads: absolute local paths or executables on PATH.
FFMPEG_PATH=ffmpeg
VIDEO_FRAME_STRATEGY=events
# Experimental structured action evidence. Keep disabled until video quality review.
# Pinned when a session starts; changing this does not alter existing sessions.
VISUAL_ACTION_EVIDENCE=0
# Optional visual fact check, using remaining calls in the same hard budget.
# Upload v3 only; a second model answer still requires the master's review.
VISUAL_SEMANTIC_REVIEW=0
# Single-call sampled transition inventory, new upload v3 sessions only.
VISUAL_SHORT_ACTION_COVERAGE=0
# Same-call frame facts, requires upload v3 + short-action coverage above.
# Keeps all request caps and disables optional extra refinement calls in this mode.
VISUAL_FRAME_GROUNDING=0
# v2 uses inline image evidence instead of model-generated entity/state references.
# This selects the contract only when the feature flags above are enabled.
VISUAL_FRAME_GROUNDING_VERSION=v2
FFPROBE_PATH=ffprobe
# Local ASR never downloads a model or sends audio to the cloud.
ASR_BACKEND=whisper_cpp
WHISPER_CPP_BINARY=
ASR_MODEL_PATH=
# Text drafting sends a transcript; visual analysis sends JPEG frames with separate consent.
# Keep keys on the server; never use a VITE_ prefix for secrets.
STEP_DRAFT_BACKEND=openai
STEP_DRAFT_ENDPOINT=https://api.openai.com/v1
STEP_DRAFT_MODEL=gpt-5.4-mini
STEP_DRAFT_API_KEY=
# NVIDIA alternative: backend=nvidia, endpoint=https://integrate.api.nvidia.com/v1,
# model=nvidia/nemotron-3.5-super-vl-120b-a12b, and NVIDIA_API_KEY below.
# NVIDIA never uses the OpenAI key. Paid calls currently fail closed until
# a verified NVIDIA pricing/usage adapter is implemented.
NVIDIA_API_KEY=
# Optional free-only OpenRouter profile (enable only after creating a key):
# STEP_DRAFT_BACKEND=openrouter
# STEP_DRAFT_ENDPOINT=https://openrouter.ai/api/v1
# STEP_DRAFT_MODEL=openrouter/free
# Routes images + JSON schema only to eligible free endpoints; no paid fallback.
# A fixed vision model ending in :free may also be selected for comparisons.
OPENROUTER_API_KEY=
OPENROUTER_FREE_DAY_CALLS=50
# Paid alternative: STEP_DRAFT_MODEL=google/gemini-2.5-flash-lite
# Lifetime cap across all sessions (USD micros). 0 blocks paid OpenRouter calls.
# For example 1500000 = $1.50. Set per-analysis/day caps below as well.
OPENROUTER_TOTAL_BUDGET_MICROUSD=0
# Optional local test via an existing Codex ChatGPT login (cloud, subscription limits).
# To opt in: backend=codex, model=gpt-6-luna, CODEX_TEST_MODE=1,
# DJANGO_DEBUG=1 and DEMO_MODE=1; CODEX_CLI_BINARY must be the installed executable.
# Endpoint and API keys are ignored in this test mode. Never use it on a public server.
CODEX_TEST_MODE=0
CODEX_CLI_BINARY=
EXTERNAL_AI_ENABLED=0
# Organization opt-in is separate:
# python backend/manage.py configure_ai --organization UUID --allow-external

# Internal AI ledger. 0 is a kill switch: it BLOCKS new AI calls, not accounting.
AI_BUDGET_ENABLED=1
# Per analysis/session call quota (also used for subscription/local modes).
AI_BUDGET_DEFAULT_CALLS=30
AI_BUDGET_MAX_CALLS=60
AI_BUDGET_ORG_DAY_CALLS=100
AI_BUDGET_ORG_MONTH_CALLS=2000
AI_BUDGET_PLATFORM_DAY_CALLS=500
# Integer USD microdollars; 1 USD = 1000000. Used only by the priced API profile.
# Verified price adapter: OpenAI gpt-5.4-mini at https://api.openai.com/v1.
# Codex uses subscription_calls, local Ollama uses local_calls; neither gets fake USD.
AI_BUDGET_DEFAULT_MICROUSD=2000000
AI_BUDGET_MAX_MICROUSD=5000000
AI_BUDGET_ORG_DAY_MICROUSD=10000000
AI_BUDGET_ORG_MONTH_MICROUSD=100000000
AI_BUDGET_PLATFORM_DAY_MICROUSD=50000000
# Full-video analysis defaults to 30-second overview windows, then at most
# one refinement level (<=15-second windows) within the remaining budget.
# These are internal spending ceilings, not customer prices or automatic charges.
